# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/autoways

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Admin Authentication
# These credentials are used for admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# JWT Secret
# Used for signing JWT tokens - CHANGE THIS IN PRODUCTION
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Email Configuration
# Used for sending contact form emails
# For Gmail: You need to enable "App Passwords" in your Google Account
# Go to: Google Account > Security > 2-Step Verification > App Passwords
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-here
DESTINATION_EMAIL=destination-email@example.com

# Note: For Gmail, you need to:
# 1. Enable 2-Step Verification
# 2. Generate an App Password
# 3. Use the App Password (16 characters without spaces) as SENDER_PASSWORD
