# ==================== SERVER CONFIGURATION ====================
PORT=5000
NODE_ENV=development

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# Rate Limiting - Max requests per 15 minutes per IP
RATE_LIMIT_MAX=100

# PM2 Cluster Instances (0 = CPU cores, or specify number)
PM2_INSTANCES=2

# ==================== DATABASE CONFIGURATION ====================
MONGODB_URI=mongodb://localhost:27017/autoways

# ==================== CORS CONFIGURATION ====================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Admin Authentication
# These credentials are used for admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# JWT Secret
# Used for signing JWT tokens - CHANGE THIS IN PRODUCTION
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# SMTP Configuration
SMTP_HOST=mail.autoways.com.np
SMTP_PORT=465
SMTP_SECURE=true

# Email Configuration
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-here
DESTINATION_EMAIL=destination-email@example.com
PARTS_CONTACT_EMAIL=parts-contact-email@example.com

# Note: For Gmail, you need to:
# 1. Enable 2-Step Verification
# 2. Generate an App Password
# 3. Use the App Password (16 characters without spaces) as SENDER_PASSWORD

# ==================== PRODUCTION NOTES ====================
# For production deployment:
# 1. Change all default passwords and secrets
# 2. Use strong, random JWT_SECRET (min 32 characters)
# 3. Set NODE_ENV=production
# 4. Configure proper MongoDB connection string with authentication
# 5. Set LOG_LEVEL=warn or error in production
# 6. Configure CORS_ORIGIN to match your production domain
# 7. Enable HTTPS and use secure connection strings
# 8. Keep this file (.env.example) in version control
# 9. Never commit actual .env file with real secrets
